# =============================================================================
# backend\.env.example - modele du fichier .env (aucun secret ici)
# Utilite : documenter les variables attendues ; copier vers backend\.env puis remplir.
# Lu par : backend\config\settings.py (cree en D2, via python-dotenv).
# =============================================================================
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire-de-50-caracteres
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=wattoptima
DB_USER=wattoptima_user
DB_PASSWORD=remplacer-par-le-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:4200